# Copy this file to .env. Never commit .env.
#
# DEFAULT: the built-in practice model (src/practice_model.py). No key, no
# internet, never rate-limited. It's a few rules, not AI, but every milestone
# works with it. To use a real model, comment these 3 lines out and fill in ONE
# provider block below.
LLM_BASE_URL=practice
LLM_API_KEY=practice
LLM_MODEL=practice

#
# LLM_MODEL must be a model that supports tool calling. To see the exact
# model names your key can use, run:
#   curl -s "$LLM_BASE_URL/models" -H "Authorization: Bearer $LLM_API_KEY"

# Optional but strongly recommended in class: a free NYC Open Data app token.
# Without it, everyone on the same Wi-Fi shares one rate limit and gets
# "429 Too Many Requests". Your instructor may post one in chat.
SODA_APP_TOKEN=
# If the city API is down or busy, the lab falls back to a saved snapshot in data/
# automatically. OFFLINE=1 (the default here) always uses the snapshot, so a busy
# city API can't slow you down. Set OFFLINE=0 for live data.
OFFLINE=1

# --- OpenRouter (has free models; free account key from openrouter.ai/keys) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openrouter/free     # routes to whichever free model has capacity right now

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<a model from your OpenAI account>

# --- Anthropic (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=<a Claude model ID from your Anthropic console>

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<key from aistudio.google.com>
# LLM_MODEL=<a Gemini model ID>

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=<a DeepSeek model ID>

# --- Ollama (runs on your laptop, no key, no cost) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama            # any text works, but it can't be empty
# LLM_MODEL=<a model from ollama.com/search?c=tools that you've pulled>
